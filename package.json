{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node server.js",
    "docker-start": "npm run prisma:migrate && npm run start",
    "setup": "npm run prisma:generate && npm run prisma:migrate",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate deploy",
    "prisma:validate": "node scripts/prisma.mjs validate && DATABASE_URL=postgresql://validate:validate@localhost:5432/validate node scripts/prisma.mjs validate",
    "prisma:sync-schema": "node scripts/prisma-schema.mjs --sync",
    "prisma:check-schema": "node scripts/prisma-schema.mjs --check",
    "validate-graphql": "tsx scripts/validate-admin-graphql.mjs",
    "cron:offer-maintenance": "node scripts/run-offer-maintenance.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "tsx --test --test-concurrency=1 app/lib/*.test.ts mobile/ios-admin/src/*.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:dev-store": "playwright test --config=playwright.dev-store.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/express": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "heic-convert": "^2.1.0",
    "isbot": "^5.1.31",
    "morgan": "^1.11.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql": "^16.14.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "yaml": "^2.9.0"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  }
}
