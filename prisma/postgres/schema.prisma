  body           String
  status         String    @default("queued")
  error          String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  attempts       Int       @default(0)
  idempotencyKey String?

  @@unique([shop, idempotencyKey])
  @@index([shop, status])
}
