  expoPushToken String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@index([shop, revokedAt])
}

/**
 * One admin iOS push per event. Idempotency is (shop, kind:requestId), so a
 * retry or double submit cannot notify the phones twice.
 */
