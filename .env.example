# UPT Plant Request Portal — environment contract.
#
# Copy to `.env` for local development, or set these as secrets on the host that
# runs the production container. `app/lib/env.server.ts` refuses to boot in
# production when a required value is missing or obviously wrong.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Shopify Partner dashboard -> Apps -> UPT Plant Request Portal -> Configuration.
# `shopify app env show` prints the same values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS origin this app is served from. Must match `application_url` in
# shopify.app.toml and the app's allowed redirect URLs. No trailing slash.
SHOPIFY_APP_URL=https://plant-requests.example.com

# PostgreSQL in production. Omit entirely for local development and the app
# falls back to the SQLite dev file (prisma/dev.sqlite).
DATABASE_URL=postgresql://user:password@host:5432/upt_portal?schema=public&sslmode=require

# Shared secret for the scheduler. POST /cron/offer-maintenance with
# `Authorization: Bearer <this value>`. The endpoint returns 404 while unset.
# On Render this is generated automatically (see render.yaml); set it by hand
# only when running outside Render — `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Access scopes. Leave unset to use REQUIRED_SHOPIFY_SCOPES from
# app/lib/env.server.ts, which is asserted to match shopify.app.toml.
# SCOPES=

# Outbound email. Without RESEND_API_KEY every message is stored in the
# EmailMessage outbox with status `preview` and nothing is delivered.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM=UPT Plant Requests <noreply@unsolicitedplanttalks.com>
# Fallback for the admin new-request notification when Settings has no address.
UPT_ADMIN_EMAIL=

# Set only for a store on a custom domain that is not *.myshopify.com.
# SHOP_CUSTOM_DOMAIN=

# Optional AI assist for plant-name suggestions. Leave every one of these unset
# and the deterministic normaliser is the only path: nothing degrades except the
# quality of the suggestions offered for admin review. AI can only ever suggest —
# it never links an identity on its own, reserves inventory or creates an offer.
# All four are required together; with any of them missing AI stays off. The
# vendor is not hard-coded, so any OpenAI-compatible /chat/completions endpoint
# works — a hosted gateway or a local runner.
# PLANT_IDENTITY_AI_PROVIDER=openai
# PLANT_IDENTITY_AI_BASE_URL=https://api.openai.com/v1
# PLANT_IDENTITY_AI_MODEL=gpt-4o-mini
# PLANT_IDENTITY_AI_API_KEY=
# Aborts the call rather than holding the admin page. Defaults to 5000.
# PLANT_IDENTITY_AI_TIMEOUT_MS=5000

# Optional AI assist for the admin Help page (/app/help). Leave every one of
# these unset and the page answers from the glossary and the app's own
# documentation by term matching and keyword retrieval, which is the only path CI
# takes. A provider can only reword and choose between passages this app already
# retrieved — it cannot introduce a rule, and an answer that cites nothing it was
# given is discarded. All four are required together, and the same
# OpenAI-compatible /chat/completions shape applies.
# HELP_ASSISTANT_AI_PROVIDER=openai
# HELP_ASSISTANT_AI_BASE_URL=https://api.openai.com/v1
# HELP_ASSISTANT_AI_MODEL=gpt-4o-mini
# HELP_ASSISTANT_AI_API_KEY=
# Aborts the call rather than holding the admin form. Defaults to 8000.
# HELP_ASSISTANT_AI_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Development only — never set these in production
# ---------------------------------------------------------------------------

# `SHOPIFY_API_KEY=devkey` plus a non-production NODE_ENV enables the local
# admin bypass, which skips Shopify OAuth entirely.
# DEV_SHOP=demo-shop.myshopify.com

# Enables the "Continue as logged in customer" demo login on /customer.
# ALLOW_CUSTOMER_DEMO_LOGIN=true

# Set to "false" to switch off demo seeding even on a demo shop. Demo data is
# already refused in production and for any shop that is not the demo shop; this
# is an extra off switch (see `isDemoDataEnabled` in app/lib/environment.server.ts).
# UPT_DEMO_DATA=false
