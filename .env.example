# Copy to .env before running prisma or the dev server: cp .env.example .env

# --- Database ---------------------------------------------------------------
# SQLite is fine for development and the demo shop. A hosted deploy needs
# durable storage, because a container filesystem is wiped on redeploy.
DATABASE_URL="file:dev.sqlite"

# --- Shopify app (required in production) -----------------------------------
# From the Shopify Partner dashboard. SHOPIFY_API_SECRET also verifies App Proxy
# signatures and webhook HMACs, so customer sign-in fails without it.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Public HTTPS URL of the deployed app. Used for OAuth callbacks and for the
# offer links in customer emails.
SHOPIFY_APP_URL=""
SCOPES="write_draft_orders,read_draft_orders,read_orders,read_customers,write_files,read_files,read_products,write_products,read_publications,write_publications"

# --- Email ------------------------------------------------------------------
# Without RESEND_API_KEY, messages are recorded in the outbox with status
# "preview" and are never delivered.
RESEND_API_KEY=""
EMAIL_FROM="UPT Plant Requests <noreply@unsolicitedplanttalks.com>"
# Fallback recipient for new-request notifications when Settings has no admin
# email configured.
UPT_ADMIN_EMAIL=""

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token for POST /cron/offer-maintenance, which expires overdue offers and
# sends expiration reminder emails. Reminders do not go out without a scheduler.
CRON_SECRET=""

# --- Local development only -------------------------------------------------
# SHOPIFY_API_KEY=devkey enables the local admin bypass and demo seed data.
# Never set these in production; NODE_ENV=production disables them regardless.
# DEV_SHOP="demo-shop.myshopify.com"
# ALLOW_CUSTOMER_DEMO_LOGIN="true"
# Set to "false" to run a local server with production-like behaviour and no
# seeded sample requests.
# UPT_DEMO_DATA="true"
