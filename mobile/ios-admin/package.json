{
  "name": "upt-admin-ios",
  "version": "1.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env APP_VARIANT=development expo start",
    "start:production": "cross-env APP_VARIANT=production expo start",
    "ios": "cross-env APP_VARIANT=development expo start --ios",
    "android": "cross-env APP_VARIANT=development expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "config:development": "cross-env APP_VARIANT=development expo config --type public --json",
    "config:production": "cross-env APP_VARIANT=production expo config --type public --json"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/material-top-tabs": "^7.6.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "^0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  }
}
